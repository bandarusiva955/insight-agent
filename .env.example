# Copy this file to .env and fill in real values. Never commit .env.

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the primary model
# GEMINI_MODEL=gemini-3.6-flash

# --- Local PostgreSQL (used by docker-compose.yml) ---
POSTGRES_DB=insightagent
POSTGRES_USER=insightagent
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# POSTGRES_HOST=127.0.0.1

# --- Hosted PostgreSQL (Neon, Supabase, ...) ---
# If set, DATABASE_URL replaces the POSTGRES_* values above.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Read-only role for AI-generated SQL (recommended) ---
# Create it with app/db/create_readonly_role.sql, then set ONE of:
# READONLY_DATABASE_URL=postgresql://insightagent_ro:password@host:5432/dbname
# or
# POSTGRES_READONLY_USER=insightagent_ro
# POSTGRES_READONLY_PASSWORD=change-me
