# Copy this file to .env and fill in real values. Never commit .env.

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the primary model
# GEMINI_MODEL=gemini-3.6-flash

# --- Local PostgreSQL (used by docker-compose.yml) ---
POSTGRES_DB=insightagent
POSTGRES_USER=insightagent
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# POSTGRES_HOST=127.0.0.1

# --- Hosted PostgreSQL (Neon, Supabase, ...) ---
# If set, DATABASE_URL replaces the POSTGRES_* values above.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Read-only role for AI-generated SQL (recommended) ---
# Create it with app/db/create_readonly_role.sql, then set ONE of:
# READONLY_DATABASE_URL=postgresql://insightagent_ro:password@host:5432/dbname
# or
# POSTGRES_READONLY_USER=insightagent_ro
# POSTGRES_READONLY_PASSWORD=change-me

# --- Access control for a public deployment (optional) ---
# Shared password in front of the whole app. Leave unset for local use.
# APP_PASSWORD=choose-a-password
# Max questions one browser session may ask (protects your Gemini quota).
# MAX_QUESTIONS_PER_SESSION=50

# --- Privacy ---
# strict = never send query results or analysis facts to Gemini for narration
# (SQL generation still sends the schema and your question).
# PRIVACY_MODE=strict

# --- Live monitor alerts (optional; console output if unset) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Uploaded data ---
# Hours before an uploaded workspace schema is swept (default 6)
# WORKSPACE_TTL_HOURS=6
